{
  "name": "briefy",
  "version": "0.34.2",
  "description": "用 AI 自动填充内容，像排报纸一样制作个性化读物的桌面应用",
  "main": "./out/main/index.js",
  "author": "Briefy Contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run check:ipc",
    "start": "electron-vite preview",
    "test": "npm run test:parse && npm run test:slots && npm run test:subscription && npm run test:search-cache",
    "test:parse": "tsx scripts/test-parse.mjs",
    "test:slots": "tsx scripts/test-slots.mjs",
    "test:subscription": "tsx scripts/test-subscription.mjs",
    "test:search-cache": "node --experimental-strip-types scripts/test-search-cache.mjs",
    "check:ipc": "node scripts/check-ipc.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.39",
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.316",
    "@langchain/core": "^1.2.9",
    "@langchain/textsplitters": "^1.0.1",
    "ai": "^7.0.83",
    "langchain": "^1.5.10",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langchain/community": "^1.1.28",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
